{
    "name": "saverio-moretti-dev/reversibleimport",
    "description": "Modulo PrestaShop 8.1: import CSV di prezzi e quantità con anteprima e ritorno indietro",
    "type": "prestashop-module",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": ["src/"]
    },
    "autoload-dev": {
        "classmap": ["tests/"]
    },
    "config": {
        "prepend-autoloader": false
    }
}
